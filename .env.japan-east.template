# Japan East Computer Vision エンドポイント設定テンプレート
# 同一リージョン内での負荷分散・フォールバックテスト用

# ==============================================
# デプロイメント情報
# ==============================================
RESOURCE_GROUP_NAME=rg-ocr-demo-japan-east
LOCATION=japaneast

# ==============================================
# Computer Vision エンドポイント設定
# ==============================================

# 3つのComputer Visionエンドポイント (カンマ区切り)
# デプロイ後に実際のURLに置き換えてください
OCR_ENDPOINTS=https://cv-ocr-demo-je-primary.cognitiveservices.azure.com/,https://cv-ocr-demo-je-secondary.cognitiveservices.azure.com/,https://cv-ocr-demo-je-tertiary.cognitiveservices.azure.com/

# Computer Vision APIキー (カンマ区切り)
# デプロイ後に以下のコマンドで取得したキーを設定してください:
# az cognitiveservices account keys list --name cv-ocr-demo-je-primary --resource-group rg-ocr-demo-japan-east --query key1 -o tsv
# az cognitiveservices account keys list --name cv-ocr-demo-je-secondary --resource-group rg-ocr-demo-japan-east --query key1 -o tsv  
# az cognitiveservices account keys list --name cv-ocr-demo-je-tertiary --resource-group rg-ocr-demo-japan-east --query key1 -o tsv
OCR_KEYS=YOUR_PRIMARY_KEY,YOUR_SECONDARY_KEY,YOUR_TERTIARY_KEY

# ==============================================
# フォールバック設定
# ==============================================

# 単発リクエストの閾値 (ms) - この値を超えるとフォールバック
FALLBACK_SINGLE_MS=2000

# EWMA P95レイテンシーの閾値 (ms)
EWMA_P95_MS=2500

# EWMA重み係数 (0.0-1.0)
EWMA_ALPHA=0.2

# クールダウン期間 (秒) - 失敗したエンドポイントの復帰待機時間
COOLDOWN_SEC=60

# リクエスト毎の最大リトライ回数
MAX_RETRIES_PER_REQUEST=2

# ==============================================
# 負荷テスト設定
# ==============================================

# 負荷テストの並行性
LOAD_TEST_CONCURRENCY=10

# 負荷テストの持続時間 (秒)
LOAD_TEST_DURATION=300

# 負荷テストの対象画像
LOAD_TEST_IMAGE_PATH=./samples/handwritten_text.jpg

# ==============================================
# ログ・監視設定
# ==============================================

# Prometheusメトリクス有効/無効
ENABLE_PROMETHEUS=true

# メトリクス公開ポート
PROMETHEUS_PORT=8000

# ログレベル (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# ==============================================
# API設定
# ==============================================

# HTTPタイムアウト (秒)
HTTP_TIMEOUT=30

# HTTP/2使用の有効/無効
ENABLE_HTTP2=true

# 同期API優先使用 (true: Image Analysis v4.0, false: Read API v3.2)
USE_SYNC_API=true