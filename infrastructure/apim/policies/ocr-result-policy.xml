<policies>
    <inbound>
        <base />
        <!-- Extract result ID from URL path -->
        <set-variable name="resultId" value="@(context.Request.MatchedParameters[&quot;resultId&quot;])" />
        
        <!-- Try to determine which backend should handle this result request -->
        <!-- For now, we'll try primary first, then fallback to others -->
        <retry condition="@(context.Response == null || context.Response.StatusCode == 404 || context.Response.StatusCode == 429 || context.Response.StatusCode &gt;= 500)" count="3" interval="1" delta="1">
            
            <!-- Select backend based on retry attempt -->
            <choose>
                <when condition="@(context.Variables.GetValueOrDefault&lt;int&gt;(&quot;currentRetry&quot;, 0) == 0)">
                    <set-backend-service backend-id="cv-primary" />
                    <set-header name="Ocp-Apim-Subscription-Key" exists-action="override">
                        <value>{{cv-primary-key}}</value>
                    </set-header>
                    <set-variable name="currentBackend" value="cv-primary" />
                </when>
                <when condition="@(context.Variables.GetValueOrDefault&lt;int&gt;(&quot;currentRetry&quot;, 0) == 1)">
                    <set-backend-service backend-id="cv-secondary" />
                    <set-header name="Ocp-Apim-Subscription-Key" exists-action="override">
                        <value>{{cv-secondary-key}}</value>
                    </set-header>
                    <set-variable name="currentBackend" value="cv-secondary" />
                </when>
                <otherwise>
                    <set-backend-service backend-id="cv-tertiary" />
                    <set-header name="Ocp-Apim-Subscription-Key" exists-action="override">
                        <value>{{cv-tertiary-key}}</value>
                    </set-header>
                    <set-variable name="currentBackend" value="cv-tertiary" />
                </otherwise>
            </choose>

            <!-- Add monitoring headers -->
            <set-header name="X-APIM-Result-Attempt" exists-action="override">
                <value>@(context.Variables.GetValueOrDefault&lt;int&gt;(&quot;currentRetry&quot;, 0) + 1)</value>
            </set-header>
            <set-header name="X-APIM-Result-Backend" exists-action="override">
                <value>@(context.Variables.GetValueOrDefault&lt;string&gt;(&quot;currentBackend&quot;, &quot;unknown&quot;))</value>
            </set-header>

            <!-- Forward the request -->
            <forward-request timeout="30" />

            <!-- Check response and handle retries -->
            <choose>
                <when condition="@(context.Response.StatusCode == 404 || context.Response.StatusCode == 429 || context.Response.StatusCode &gt;= 500)">
                    <set-variable name="currentRetry" value="@(context.Variables.GetValueOrDefault&lt;int&gt;(&quot;currentRetry&quot;, 0) + 1)" />
                    <trace source="ResultRetrieval">
                        <message>@($"Result request failed with status {context.Response.StatusCode} on backend {context.Variables.GetValueOrDefault&lt;string&gt;(&quot;currentBackend&quot;, &quot;unknown&quot;)} for result ID {context.Variables.GetValueOrDefault&lt;string&gt;(&quot;resultId&quot;, &quot;unknown&quot;)}")</message>
                    </trace>
                </when>
                <otherwise>
                    <!-- Success - break out of retry loop -->
                    <set-variable name="currentRetry" value="999" />
                </otherwise>
            </choose>
        </retry>
    </inbound>
    
    <backend>
        <base />
    </backend>
    
    <outbound>
        <base />
        <!-- Add custom headers to track result retrieval -->
        <set-header name="X-Result-Served-By-Backend" exists-action="override">
            <value>@(context.Variables.GetValueOrDefault&lt;string&gt;(&quot;currentBackend&quot;, &quot;unknown&quot;))</value>
        </set-header>
        <set-header name="X-Result-Request-Attempts" exists-action="override">
            <value>@(context.Variables.GetValueOrDefault&lt;int&gt;(&quot;currentRetry&quot;, 0))</value>
        </set-header>
    </outbound>
    
    <on-error>
        <base />
        <!-- Log errors for debugging -->
        <trace source="ResultRetrievalError">
            <message>@($"Error retrieving result: {context.LastError.Message} on backend {context.Variables.GetValueOrDefault&lt;string&gt;(&quot;currentBackend&quot;, &quot;unknown&quot;)} for result ID {context.Variables.GetValueOrDefault&lt;string&gt;(&quot;resultId&quot;, &quot;unknown&quot;)}")</message>
        </trace>
    </on-error>
</policies>